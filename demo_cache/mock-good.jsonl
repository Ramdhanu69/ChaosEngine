{"key": "26e7f44db0f06d97f366e5ae8d31d1905246137df5d43cbb059618c2fa306426", "response": {"error": null, "latency_s": 0.05, "raw": {"choices": [{"message": {"content": "```python\ndef k_most_frequent(nums, k):\n    counts = {}\n    first = {}\n    for i, n in enumerate(nums):\n        counts[n] = counts.get(n, 0) + 1\n        if n not in first: first[n] = i\n    return sorted(counts.keys(), key=lambda x: (-counts[x], first[x]))[:k]\n```", "tool_calls": []}}], "usage": {"completion_tokens": 10, "prompt_tokens": 10}}}}
{"key": "3a2a741482d42b0bdab3fd34ab9028c62fe441775a75b7f700a6dde8a382fb55", "response": {"error": null, "latency_s": 0.05, "raw": {"choices": [{"message": {"content": "```python\ndef run_length_encoding(s):\n    if not s: return []\n    res = []\n    cur, cnt = s[0], 1\n    for ch in s[1:]:\n        if ch == cur: cnt += 1\n        else:\n            res.append([cur, cnt])\n            cur, cnt = ch, 1\n    res.append([cur, cnt])\n    return res\n```", "tool_calls": []}}], "usage": {"completion_tokens": 10, "prompt_tokens": 10}}}}
{"key": "f3c5ca7f6451f6dc014f24a3f306a087288f03944eb47e7c2efb3c0aa5d44172", "response": {"error": null, "latency_s": 0.05, "raw": {"choices": [{"message": {"content": "```python\ndef second_largest(nums):\n    dist = sorted(list(set(nums)), reverse=True)\n    return dist[1] if len(dist) >= 2 else None\n```", "tool_calls": []}}], "usage": {"completion_tokens": 10, "prompt_tokens": 10}}}}
{"key": "d11964155f0156d01fdcb4535885543a97e9361779e3fa82ff0fd3efe5f94eeb", "response": {"error": null, "latency_s": 0.05, "raw": {"choices": [{"message": {"content": "```python\ndef balanced_brackets(s):\n    st = []\n    pairs = {')': '(', ']': '[', '}': '{'}\n    for c in s:\n        if c in pairs.values(): st.append(c)\n        elif c in pairs:\n            if not st or st.pop() != pairs[c]: return False\n    return len(st) == 0\n```", "tool_calls": []}}], "usage": {"completion_tokens": 10, "prompt_tokens": 10}}}}
{"key": "ea7e15ccb0e825d04d7d4622b45d975e99d7488a32ec924a3f510294d37f4b0f", "response": {"error": null, "latency_s": 0.05, "raw": {"choices": [{"message": {"content": "```python\ndef merge_intervals(intervals):\n    if not intervals: return []\n    s = sorted(intervals, key=lambda x: x[0])\n    res = [s[0]]\n    for cur in s[1:]:\n        prev = res[-1]\n        if cur[0] <= prev[1]: prev[1] = max(prev[1], cur[1])\n        else: res.append(cur)\n    return res\n```", "tool_calls": []}}], "usage": {"completion_tokens": 10, "prompt_tokens": 10}}}}
